# PlatformIO build output and caches
.pio/
.pioenvs/
.piolibdeps/
compile_commands.json

# Release packaging output (tools/release/package.py)
/release/

# Keys, secrets and signatures: never commit them. The OTA private key lives
# only on the maintainer's machine (tools/ota/) and in the OTA_SIGNING_KEY
# secret; the public key is compiled into src/ota_signing.h.
*.pem
*.key
*.p12
*.pfx
.env
.env.*
*.sig

# Host-test binaries
test/*.out
test/*.bin

# Python
__pycache__/
*.py[cod]
.venv/

# Editors and OS (keep the shared extension recommendation)
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
